{
  "name": "dsh-mic-asr",
  "version": "0.1.0",
  "description": "Microphone dictation for DeepSeek Harness: local noise suppression and streaming speech recognition with VAD and voiceprint filtering, inserted into the composer.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "speech-recognition",
    "dictation",
    "asr",
    "noise-suppression",
    "denoise",
    "vad",
    "voiceprint"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "jiangbojin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangbojin/dsh-mic-asr.git",
    "directory": "packages/dsh-mic-asr"
  },
  "bugs": {
    "url": "https://github.com/jiangbojin/dsh-mic-asr/issues"
  },
  "homepage": "https://github.com/jiangbojin/dsh-mic-asr#readme",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "lib/types/types.js"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "build": "node ../../scripts/prepare-typert.mjs && tsdown && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE');require('node:fs').copyFileSync('../../NOTICE','NOTICE');require('node:fs').copyFileSync('../../README.md','README.md');require('node:fs').copyFileSync('../../README.en.md','README.en.md')\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.30.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
